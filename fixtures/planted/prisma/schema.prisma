generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

model User {
  id    String @id
  name  String
  email String @unique
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    String
  createdAt DateTime @default(now())
}
